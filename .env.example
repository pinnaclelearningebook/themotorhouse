# Copy to .env.local and fill in as keys arrive. Every key here is
# tracked in PENDING-INFO.md. Without the Airtable and Resend keys the
# form accepts submissions but stores and sends NOTHING — the server
# logs loudly and /valuation shows a dev banner while they are missing.

# Airtable — submission storage (lib/submissions.ts)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Submissions

# Resend — operator alert + seller auto-reply (lib/email.ts)
RESEND_API_KEY=
# Must be on the verified sending domain, e.g. "The Motor House <offers@example.co.uk>"
EMAIL_FROM=
OPERATOR_ALERT_EMAIL=

# DVLA Vehicle Enquiry Service — reg lookup stub (lib/vehicle-lookup.ts)
DVLA_VES_API_KEY=
# DVSA MOT History API — mileage history (not yet wired)
DVSA_MOT_CLIENT_ID=
DVSA_MOT_CLIENT_SECRET=
DVSA_MOT_API_KEY=
