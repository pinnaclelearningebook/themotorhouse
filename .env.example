# Copy to .env.local and fill in as keys arrive. Mirrors ARCHITECTURE.md
# section 8. Every variable is annotated with the phase that needs it
# (CLAUDE.md section 13), so nothing is chased before it is required.
#
# Env vars live in Vercel for deployed environments and are never committed.
# No key in this file is ever exposed to the browser except NEXT_PUBLIC_*.
#
# Behaviour when a value is missing:
#   required key absent  → loud server log and a dev banner, never a silent success
#   optional key absent  → the adapter returns null and /admin shows the
#                          control disabled with the reason
#
# Every unset value here has a matching line in PENDING-INFO.md.


# ─── Phase A — live now ────────────────────────────────────────────────

# Absolute site URL for canonicals, sitemap and OG images (config/site.ts).
# Falls back to Vercel's production URL, then localhost. Set once the real
# domain exists.
NEXT_PUBLIC_SITE_URL=

# Resend — seller auto-reply and operator alerts (lib/email.ts).
RESEND_API_KEY=
# Must be on the verified sending domain, e.g. "The Motor House <offers@example.co.uk>"
EMAIL_FROM=
# Comma-separated. Every address here is alerted on a new lead, and from
# Phase C on the scored enrichment with a deep link to /admin.
OPERATOR_EMAILS=


# ─── Superseded — Airtable ─────────────────────────────────────────────

# Postgres replaced Airtable as the submissions store in Phase B. The
# adapter is kept unused at lib/adapters/airtable.ts so the Phase A store
# is recoverable if the migration has to be rolled back. Nothing reads
# these unless that adapter is wired back in.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Submissions


# ─── Phase B — storage ─────────────────────────────────────────────────

# Supabase — Postgres, Auth and RLS from one project.
# The service role key bypasses row-level security: server-side only,
# never in a client component, never prefixed NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Blob — seller photos, client-direct signed uploads.
BLOB_READ_WRITE_TOKEN=


# ─── Phase B — live vehicle data (both free, both server-side only) ────

# DVLA Vehicle Enquiry Service. Sent as the x-api-key header.
# Apply via the DVLA developer portal; approval takes days.
DVLA_VES_API_KEY=

# DVSA MOT History. OAuth2 client credentials — not a single API key.
# Tokens last 60 minutes and are cached in module scope.
#
# NOTE: the old beta.check-mot.service.gov.uk API was retired in
# September 2025. This is the replacement, which uses OAuth2.
DVSA_MOT_CLIENT_ID=
DVSA_MOT_CLIENT_SECRET=
DVSA_MOT_API_KEY=
# Defaults to https://tapi.dvsa.gov.uk/.default if unset.
DVSA_MOT_SCOPE=
# DVSA issues this at registration and it contains an account-specific
# tenant id, so it cannot be a constant. Shape:
#   https://login.microsoftonline.com/{tenantId}/oauth2/v2.0/token
# Not listed in ARCHITECTURE.md section 8 as originally written.
DVSA_MOT_TOKEN_URL=
# Optional override. Defaults to https://history.mot.api.gov.uk
DVSA_MOT_API_BASE=


# ─── Phase C — admin and background jobs ───────────────────────────────

# Comma-separated emails allowed to sign into /admin by magic link.
# Anyone not on this list is redirected at the layout, not just hidden.
ADMIN_ALLOWLIST=

# Inngest — only if Inngest wins the job-runner decision in Phase C.
# ARCHITECTURE.md section 9 records that choice; leave blank for Vercel cron.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=


# ─── Phase D — the virtual employee ────────────────────────────────────

# ElevenLabs Conversational AI. Kept behind agent/elevenlabs.ts so the
# provider stays swappable.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=


# ─── Phase E — paid adapters (optional) ────────────────────────────────

# Both are paid per call and are only ever run by a human pressing a
# button in /admin. There is no code path that calls either automatically.
# Absent → the adapter returns null and the control is disabled with a reason.

# Provenance: hpi | experian
PROVENANCE_PROVIDER=
PROVENANCE_API_KEY=

# Valuation: ukvehicledata | checkcardetails | caphpi
VALUATION_PROVIDER=
VALUATION_API_KEY=
