# The Motor House — environment variables
#
# Copy to .env.local and fill in. Nothing here holds a real value; every
# unknown is tracked in PENDING-INFO.md. Variables are grouped by the
# build phase that needs them, so an empty one tells you which phase is
# blocked rather than just failing.
#
# Vercel holds the deployed copies. Set them with the CLI, not the
# dashboard (CLAUDE.md section 2):
#   vercel env add NAME production
#
# ─────────────────────────────────────────────────────────────────────
# Phase A — the site and the form. Required for a working submission.
# ─────────────────────────────────────────────────────────────────────

# Supabase. One set of names, used on the server only: there is no
# NEXT_PUBLIC_ pair, because admin sign-in happens in a Server Action and
# the browser never needs the project keys.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend. EMAIL_FROM must be on a verified domain or sending fails.
RESEND_API_KEY=
EMAIL_FROM=

# Who gets the operator alert when a lead lands. Comma-separated.
OPERATOR_EMAILS=

# Canonical origin, used for metadata, sitemap and OG images. Vercel
# supplies VERCEL_PROJECT_PRODUCTION_URL automatically as a fallback.
NEXT_PUBLIC_SITE_URL=

# ─────────────────────────────────────────────────────────────────────
# Phase B — photo upload.
# ─────────────────────────────────────────────────────────────────────

# Vercel Blob. Uploads are signed client-direct; without this the photo
# step logs loudly and the lead is still saved.
BLOB_READ_WRITE_TOKEN=

# ─────────────────────────────────────────────────────────────────────
# Phase C — enrichment, the decision engine and the admin dashboard.
# ─────────────────────────────────────────────────────────────────────

# Admin sign-in. Comma-separated addresses, and the only addresses that
# can request a magic link. Keep in step with the admin_users table by
# running: npm run sync-admins
ADMIN_ALLOWLIST=

# Development only. Skips the magic link when working on admin pages.
# Dead code in any deployed environment: Next sets NODE_ENV=production
# for every build, and test/constraints.test.ts asserts the guard stays.
ADMIN_DEV_BYPASS=

# Authorises the daily enrichment sweep. Vercel's own cron is identified
# by its x-vercel-cron header; this covers manual and external calls.
CRON_SECRET=

# DVLA Vehicle Enquiry Service. Free, but requires an application.
# Note the API returns no model field — see ARCHITECTURE.md section 9.
DVLA_VES_API_KEY=
DVLA_VES_URL=

# DVSA MOT History. OAuth2, and the token URL is specific to the account
# Terms-of-use acceptance creates, so it cannot be guessed.
DVSA_MOT_API_KEY=
DVSA_MOT_CLIENT_ID=
DVSA_MOT_CLIENT_SECRET=
DVSA_MOT_SCOPE=
DVSA_MOT_TOKEN_URL=
DVSA_MOT_API_BASE=

# Paid, per-call checks. Deliberately unset. No code path may call these
# without a human pressing a button in /admin — enforced by
# test/constraints.test.ts, not by convention.
PROVENANCE_PROVIDER=
PROVENANCE_API_KEY=
VALUATION_PROVIDER=
VALUATION_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Superseded. Airtable was the Milestone 1 store, replaced by Supabase
# in Phase A. Kept only so an old .env.local does not look authoritative.
# ─────────────────────────────────────────────────────────────────────
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=
